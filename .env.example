# ============================================================
# YouTube Omni-Extractor — arquivo de configuração
# ============================================================
# Copie este arquivo para .env e ajuste os valores.
# O .env NUNCA deve ser commitado (já está no .gitignore).
#
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
# ============================================================

# ----------------------------------------------------------
# LIMITES DE EXTRAÇÃO (quantos vídeos por tipo)
# ----------------------------------------------------------

# Quantos vídeos terão o ARQUIVO DE MÍDIA baixado (mp4/mkv).
# Aumentar muito ocupa muito espaço em disco e leva horas.
MAX_VIDEOS_DOWNLOAD=5

# Quantos vídeos terão o JSON completo de metadados extraído.
# Operação leve (sem download de vídeo).
MAX_VIDEOS_METADADOS=30

# Quantos vídeos terão comentários coletados.
# Operação moderada (uma requisição de API por vídeo).
MAX_VIDEOS_COMENTARIOS=10

# ----------------------------------------------------------
# LIMITE DE COMENTÁRIOS POR VÍDEO
# ----------------------------------------------------------
# ATENÇÃO: esta variável é diferente de MAX_VIDEOS_COMENTARIOS.
# MAX_COMENTARIOS  = quantos comentários DENTRO de cada arquivo .txt
# MAX_VIDEOS_COMENTARIOS = quantos VÍDEOS recebem um arquivo de comentários
MAX_COMENTARIOS=100

# ----------------------------------------------------------
# FRAMES
# ----------------------------------------------------------
# Intervalo em segundos entre cada captura de frame (ffmpeg).
# 30 = 1 frame a cada 30 segundos de vídeo.
INTERVALO_FRAMES=30

# ----------------------------------------------------------
# DELAY ENTRE REQUISIÇÕES (anti-rate-limit)
# ----------------------------------------------------------
# O extrator aguarda um tempo aleatório entre DELAY_MIN e
# DELAY_MAX segundos antes de cada requisição ao YouTube.
# Reduzir muito aumenta o risco de bloqueio (erro 429).
DELAY_MIN=10
DELAY_MAX=20
